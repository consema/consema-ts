{
  "name": "@consema/consema",
  "version": "0.14.0",
  "description": "TypeScript implementation of the language-neutral Consema configuration-processing contracts (RFC 0016; docs/multi-language-implementation-plan.md)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:byte-parity": "node --test \"src/differential/parity/**/*.test.ts\"",
    "test:normalized": "node --test \"src/differential/normalized/**/*.test.ts\"",
    "test:exchange": "node --test \"src/differential/exchange/**/*.test.ts\"",
    "test:differential": "node --test \"src/differential/**/*.test.ts\""
  },
  "keywords": [
    "consema",
    "configuration",
    "language-neutral"
  ],
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~5.9.0"
  }
}
