{
  "name": "@consema/consema",
  "version": "1.0.0-rc.1",
  "description": "TypeScript implementation of the language-neutral Consema configuration-processing contracts (RFC 0016; https://github.com/consema/consema/blob/main/docs/multi-language-implementation-plan.md)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/consema/consema-ts.git"
  },
  "homepage": "https://github.com/consema/consema-ts",
  "bugs": {
    "url": "https://github.com/consema/consema-ts/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node -e \"require('node:fs').copyFileSync('../LICENSE', 'LICENSE')\"",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:byte-parity": "node --test \"src/differential/parity/**/*.test.ts\"",
    "test:normalized": "node --test \"src/differential/normalized/**/*.test.ts\"",
    "test:exchange": "node --test \"src/differential/exchange/**/*.test.ts\"",
    "test:differential": "node --test \"src/differential/**/*.test.ts\""
  },
  "keywords": [
    "consema",
    "configuration",
    "language-neutral"
  ],
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~5.9.0"
  }
}
